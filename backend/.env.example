# Used when running the API outside Docker (uvicorn app.main:app --reload)
DATABASE_URL=mysql+pymysql://bookxpert:bookxpert@localhost:3310/sales_inventory
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=480
FRONTEND_URL=http://localhost:5174
CORS_ORIGINS=["http://localhost:5174","http://localhost:3000"]
DEFAULT_APPROVAL_THRESHOLD=50000

# Mailpit (local inbox at http://localhost:8025). For Gmail use smtp.gmail.com:587,
# SMTP_USE_TLS=true and an App Password.
SMTP_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM=BookXpert Sales <no-reply@bookxpert.local>
